# .env.template
# -------------------------------------------------------------------
# SmokePing + InfluxDB + Grafana stack - Template Configuration
# -------------------------------------------------------------------
# IMPORTANT: You must run ./init-passwords-docker.sh first!
# This will generate secure random passwords and create a .env file.
# Docker Compose will NOT start without proper password initialization.
# -------------------------------------------------------------------

# InfluxDB connection
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=supersecrettoken
INFLUX_ORG=smokingpi
INFLUX_BUCKET=latency

# InfluxDB admin credentials (will be auto-generated)
# Leave this line commented out for auto-generation
# DOCKER_INFLUXDB_INIT_PASSWORD=

# PostgreSQL credentials (will be auto-generated)
# Leave this line commented out for auto-generation
# POSTGRES_PASSWORD=

# SmokePing RRD directory inside its container
RRD_DIR=/var/lib/smokeping

# Timezone configuration (will be auto-detected)
# Examples: America/New_York, Europe/London, Asia/Tokyo
TZ=UTC

# Web Admin Interface (will be auto-generated)
SECRET_KEY=your-secret-key-here-change-in-production
WEB_ADMIN_USERNAME=admin
# WEB_ADMIN_PASSWORD=  # Leave commented for auto-generation

# Grafana admin credentials (will be auto-generated)
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=  # Leave commented for auto-generation
# GF_SECURITY_SECRET_KEY=  # Leave commented for auto-generation (used for cookie signing)

# -------------------------------------------------------------------
# USAGE:
# 1. Run: ./init-passwords-docker.sh to generate secure passwords
# 2. Then run: docker-compose up -d to start the stack
# 3. Run: ./show-passwords.sh to view all generated credentials
# 
# Note: Docker Compose will fail if passwords haven't been initialized!
# -------------------------------------------------------------------