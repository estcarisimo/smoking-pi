# SmokePing Basic Edition Configuration
# Copy this file to .env and adjust the values

# User and Group IDs (for file permissions)
PUID=1000
PGID=1000

# Timezone (use your local timezone)
TZ=Europe/London

# SmokePing Web Interface Port
SMOKEPING_PORT=8080

# Optional: Custom hostname/domain for web interface
# HOSTNAME=smokeping.local