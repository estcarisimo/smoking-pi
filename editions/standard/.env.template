# Standard Edition Environment Variables
#
# Change settings with `smoking-pi config set KEY VALUE` (`config list` shows
# them by section, `config describe KEY` explains one), not by editing the
# env file: the command checks the value and restarts what reads it.
# This template is also their schema. `## Name` starts a section; a `#:` line
# describes the key right below it: a type (int, float, bool: true/false/1/0,
# enum:a|b, time, date, tz, url, origin: https://host[:port]), bounds (min=N,
# gt=N: above N, max=N, allow=V: V as well), and flags (secret: shown only on
# request; install: generated or fixed at install, which `config set`
# refuses).

## General
# Timezone configuration
#: tz
TZ=UTC

## PostgreSQL
# PostgreSQL Database
# NOTE: must match the database name in shared/modules/postgres/init/*.sql
#: install
POSTGRES_DB=smokeping_targets
#: install
POSTGRES_USER=smokeping
#: secret install
POSTGRES_PASSWORD=

## Web admin
# Web Admin Configuration
WEB_ADMIN_USERNAME=admin
#: secret install
WEB_ADMIN_PASSWORD=
# Preferred: pbkdf2 password hash (takes precedence over WEB_ADMIN_PASSWORD).
# Generate with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash(input('password: ')))"
#: secret
WEB_ADMIN_PASSWORD_HASH=
#: int min=1 max=65535
WEB_ADMIN_PORT=8080
# Run web-admin background jobs (daily OCA refresh + cache cleanup)
#: bool
ENABLE_SCHEDULER=true

## SmokePing
# SmokePing Configuration
#: int min=1 max=65535
SMOKEPING_PORT=80

## Config API
# Flask Configuration
#: secret install
SECRET_KEY=

# Config Manager API auth. setup.sh generates this; empty means the API
# is unauthenticated. config-manager requires "Authorization: Bearer <token>"
# on all routes except /health; web-admin sends it automatically.
#: secret install
CONFIG_API_TOKEN=

## Measurement budget
# Measurement budget (see docs/measurement-budget.md): ceilings that
# `smoking-pi budget` compares the configured measurements against.
# Accounting only, nothing is throttled. Empty = 1000 MB/day, 20000/h.
#: float min=0
MEASUREMENT_BUDGET_MB_PER_DAY=
#: float min=0
MEASUREMENT_BUDGET_SAMPLES_PER_HOUR=

## mDNS
# The Pi's name on the LAN (docs/mdns.md): the mdns service answers for
# <MDNS_NAME>.local. Empty = smoking-pi (smoking-pi.local); off = no name.
# A second Smoking Pi on the network gets <name>-2.local: give each its own.
# MDNS_INTERFACES: comma-separated interfaces; empty = every LAN interface.
MDNS_NAME=
MDNS_INTERFACES=

## Volume paths
# Volume paths (optional)
# POSTGRES_DATA_PATH=/path/to/postgres/data
# SMOKEPING_DATA_PATH=/path/to/smokeping/data

## State locations
# Where the stack keeps the state it rewrites (docs/packaging.md, "Relocatable
# state"). Unset, everything stays beside this file, untracked by git:
#   SMOKING_PI_CONFIG_DIR   targets/probes/sources YAML the stack edits
#                           (default ./config-manager/config; an empty
#                           directory is seeded on first start)
# A packaged install sets it to /etc/smoking-pi/config. Paths are relative to
# this directory. The env file itself is relocated with SMOKING_PI_ENV_FILE, read by setup.sh,
# show-passwords.sh and the smoking-pi command (docker compose --env-file).
#SMOKING_PI_CONFIG_DIR=
