# Standard Edition Environment Variables

# Timezone configuration
TZ=UTC

# PostgreSQL Database
# NOTE: must match the database name in shared/modules/postgres/init/*.sql
POSTGRES_DB=smokeping_targets
POSTGRES_USER=smokeping
POSTGRES_PASSWORD=

# Web Admin Configuration
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=
WEB_ADMIN_PORT=8080

# SmokePing Configuration
SMOKEPING_PORT=80

# Flask Configuration
SECRET_KEY=

# Volume paths (optional)
# POSTGRES_DATA_PATH=/path/to/postgres/data
# SMOKEPING_DATA_PATH=/path/to/smokeping/data