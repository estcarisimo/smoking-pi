# Standard Edition Environment Variables

# Timezone configuration
TZ=UTC

# PostgreSQL Database
# NOTE: must match the database name in shared/modules/postgres/init/*.sql
POSTGRES_DB=smokeping_targets
POSTGRES_USER=smokeping
POSTGRES_PASSWORD=

# Web Admin Configuration
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=
# Preferred: pbkdf2 password hash (takes precedence over WEB_ADMIN_PASSWORD).
# Generate with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash(input('password: ')))"
WEB_ADMIN_PASSWORD_HASH=
WEB_ADMIN_PORT=8080
# Run web-admin background jobs (daily OCA refresh + cache cleanup)
ENABLE_SCHEDULER=true

# SmokePing Configuration
SMOKEPING_PORT=80

# Flask Configuration
SECRET_KEY=

# Config Manager API auth (optional)
# When set, config-manager requires "Authorization: Bearer <token>" on all
# routes except /health; web-admin sends it automatically.
CONFIG_API_TOKEN=

# Volume paths (optional)
# POSTGRES_DATA_PATH=/path/to/postgres/data
# SMOKEPING_DATA_PATH=/path/to/smokeping/data