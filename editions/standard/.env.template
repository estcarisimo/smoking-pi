# SmokePing Standard Edition Configuration
# Copy this file to .env and adjust the values

# Timezone (use your local timezone)
TZ=UTC

# PostgreSQL Database Configuration
POSTGRES_DB=smokeping_targets
POSTGRES_USER=smokeping
POSTGRES_PASSWORD=
# Generate a strong password: openssl rand -base64 32

# Web Admin Interface Configuration  
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=
# Generate a strong password: openssl rand -base64 32

# Security Configuration
SECRET_KEY=
# Generate a secret key: openssl rand -hex 32

# Service Ports
WEB_ADMIN_PORT=8080
SMOKEPING_PORT=8081

# Optional: Custom hostname/domain
# HOSTNAME=smokeping.local