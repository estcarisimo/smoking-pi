## Grafana
# Grafana Configuration
#: install
GF_SECURITY_ADMIN_USER=admin
#: secret install
GF_SECURITY_ADMIN_PASSWORD=
#: secret install
GF_SECURITY_SECRET_KEY=
# Snapshots are OFF. A snapshot is a permanent, unauthenticated URL with your
# measurements embedded in it, and it is one click away in Grafana's share
# dialog. Everything else here requires a login, so this is the only way to
# make network data public by accident. EXTERNAL is separate and otherwise
# defaults ON: it publishes to the third-party snapshots.raintank.io.
# Alert links point at Grafana and the reader signs in — see docs/alerting.md
#: bool
GF_SNAPSHOTS_ENABLED=false
#: bool
GF_SNAPSHOTS_EXTERNAL_ENABLED=false

## SmokePing
# SmokePing Configuration
RRD_DIR=/data
# Resolver the smokeping container uses for its own hostname lookups. Pinned
# rather than inherited, because Docker writes a container's /etc/resolv.conf
# ONCE at creation: inheriting freezes whatever the host happened to be using
# at that instant, and a VPN/split-DNS resolver that later goes away takes
# every hostname target down silently (raw-IP targets keep working, which is
# the tell). Override for a deployment whose targets are internal names.
# The DNS *probes* are unaffected — they run `dig` against an explicit server.
SMOKEPING_DNS=
SMOKEPING_DNS_FALLBACK=

## CPE and microcuts
# CPE Microcut Detection
#: int min=1
CPE_DISCOVERY_INTERVAL=3600
#: int min=1 max=1000
CPE_PROBE_RATE=5
#: int min=1
CPE_PROBE_WINDOW=10
# Idle seconds between CPE probe windows (default 20; 0 = probe continuously)
#: int min=0
CPE_PROBE_IDLE=
CPE_IPV6_TARGET=dns.google
CPE_IPV4_TARGET=8.8.8.8
#: int min=2
CPE_MAX_HOPS=5
# What counts as a microcut (docs/detection-reliability.md): a 10 s window
# above MICROCUT_LOSS_PCT (default 50 -- the gateway's ICMP rate-limit floor
# sits far below), and microcut_burst fires on a confirmed cut (two
# consecutive such windows, or one at 100%) or on MICROCUT_BURST_N isolated
# ones in the hour (default 3). Read by the alerter, the MCP tool, the digest
# and the AI report alike.
#: int min=0 max=100
MICROCUT_LOSS_PCT=
#: int min=1
MICROCUT_BURST_N=

