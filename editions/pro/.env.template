# SmokePing Pro Edition Environment Configuration
# Copy to .env and customize for your deployment

# Time-Series Database Selection
# Choose between 'influxdb' or 'clickhouse'
TSDB_TYPE=clickhouse

# InfluxDB Configuration (when TSDB_TYPE=influxdb)
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=smokeping
INFLUX_BUCKET=smokeping
DOCKER_INFLUXDB_INIT_PASSWORD=your-influxdb-admin-password

# ClickHouse Configuration (when TSDB_TYPE=clickhouse)
CLICKHOUSE_USER=smokeping
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DB=smokeping

# PostgreSQL Configuration
POSTGRES_PASSWORD=your-postgres-password

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password
GF_SECURITY_SECRET_KEY=your-grafana-secret-key

# Web Admin Configuration
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=your-web-admin-password
SECRET_KEY=your-web-admin-secret-key

# System Configuration
TZ=UTC
RRD_DIR=/var/lib/smokeping

# Optional: Grafana Plugin Installation
# GF_INSTALL_PLUGINS=grafana-piechart-panel,grafana-worldmap-panel