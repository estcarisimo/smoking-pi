MDNS_INTERFACES=

## DNS observer
# DNS observer (opt-in: `smoking-pi dns enable`, which adds `dns` to
# COMPOSE_PROFILES). AdGuard Home, filtering off, answering on port 53 for the
# router to forward the house's DNS to. docs/dns-observer.md explains the
# router side and what to set so the house stays online if the Pi is down.
# Every key below may stay empty: empty means the default in its comment.
# Admin password for AdGuard Home's UI (user smokingpi). setup.sh generates it;
# `smoking-pi dns enable` generates it on an older install. Re-hashed on each
# start, so it can be rotated with `smoking-pi config set DNS_ADMIN_PASSWORD`.
#: secret
DNS_ADMIN_PASSWORD=
# Where the admin UI listens. Default 127.0.0.1:3053: this machine only (an
# SSH tunnel from elsewhere). 0.0.0.0:3053 opens it to the network, behind the
# password; the query log it shows holds every name the house resolves.
DNS_ADMIN_ADDRESS=
# Upstreams, in order: encrypted first, plain DNS last. Public addresses only:
# the router forwards to the Pi, so the router as upstream is a loop.
# Defaults: https://1.1.1.1/dns-query,https://8.8.8.8/dns-query | 1.1.1.1,8.8.8.8
# (DNS_FALLBACK=none: no plain-DNS fallback) | 1.1.1.1,8.8.8.8 | 2000
DNS_UPSTREAMS=
DNS_FALLBACK=
DNS_BOOTSTRAP=
#: int min=200
DNS_UPSTREAM_TIMEOUT_MS=
#: bool
DNS_ALLOW_PRIVATE_UPSTREAM=
# Who is answered (default: private, loopback, link-local, ULA and CGNAT
# ranges; never empty) and where (defaults 0.0.0.0 and 53).
DNS_ALLOW_CLIENTS=
DNS_BIND=
#: int min=1 max=65535
DNS_PORT=
# Names are kept on the Pi only, for this many days (default 7); client
# addresses are masked (default 1).
#: int min=1
DNS_RETENTION_DAYS=
#: bool
DNS_ANONYMIZE_CLIENTS=
# The canary tells a quiet house from a router that stopped forwarding here:
# a unique name asked of the router (auto = the default gateway; off; or an
# address) every DNS_CANARY_INTERVAL seconds (default 300); DNS_CANARY_MISSES
# in a row (default 3) unseen = not receiving. Defaults: auto,
# canary.smoking-pi.home.arpa, 300, 3, and 1800 s of silence before "quiet".
DNS_CANARY_VIA=
DNS_CANARY_DOMAIN=
#: int min=30
DNS_CANARY_INTERVAL=
#: int min=1
DNS_CANARY_MISSES=
#: int min=60
DNS_QUIET_AFTER=
# The DNS wizard (docs/dns-observer.md, "The DNS wizard"): what the house
# resolves, per service, summarised every DNS_WIZARD_INTERVAL seconds
# (default 600; 0 = off), the DNS_WIZARD_TOP (25) busiest by presence.
# DNS_WIZARD_EXCLUDE: more names to leave out (comma list; .suffix or a
# domain), on top of the Pi's own traffic. The numbers go to InfluxDB for the
# "DNS wizard" dashboard; the service NAMES only with DNS_EXPORT_NAMES=1,
# since Grafana may be reachable from outside.
#: int min=60 allow=0
DNS_WIZARD_INTERVAL=
#: int min=1
DNS_WIZARD_TOP=
# What the wizard selects for `smoking-pi dns adopt` to measure: the
# services behind DNS_WIZARD_COVERAGE (default 0.8) of the house's activity,
# ranked by DNS_WIZARD_SCORE (auto: volume until 72 h of data, then hours
# present; or presence / queries), plus one service per network (AS) and CDN
# holding at least DNS_WIZARD_FLOOR (0.005) of it; at most DNS_WIZARD_MAX
# (60) services in all. K comes from the data, not a constant.
DNS_WIZARD_EXCLUDE=
#: enum:auto|presence|queries
DNS_WIZARD_SCORE=
#: float gt=0 max=1
DNS_WIZARD_COVERAGE=
#: float gt=0 max=1
DNS_WIZARD_FLOOR=
#: int min=1
DNS_WIZARD_MAX=
#: bool
DNS_EXPORT_NAMES=

## Public resolver
# Which public resolver answers for the house (docs/public-resolver.md), from
# the SmokePing container. Every RESOLVER_INTERVAL seconds (default 900),
# through RESOLVER_VIA (default auto: the default gateway; off; or an
# address) and through the DNS observer when it runs (RESOLVER_OBSERVER=off
# skips that path).
