# Pro Edition Environment Variables

# Timezone configuration
TZ=UTC

# Database Type: influxdb or clickhouse
TSDB_TYPE=influxdb

# InfluxDB Configuration
DOCKER_INFLUXDB_INIT_PASSWORD=
INFLUX_TOKEN=
INFLUX_ORG=smokeping
INFLUX_BUCKET=smokeping

# ClickHouse Configuration (if TSDB_TYPE=clickhouse)
CLICKHOUSE_USER=smokeping
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=smokeping

# PostgreSQL Database
POSTGRES_DB=smokeping_targets
POSTGRES_USER=smokeping
POSTGRES_PASSWORD=

# Web Admin Configuration
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GF_SECURITY_SECRET_KEY=

# SmokePing Configuration
RRD_DIR=/data

# CPE Microcut Detection
CPE_DISCOVERY_INTERVAL=3600
CPE_PROBE_RATE=5
CPE_PROBE_WINDOW=10
CPE_IPV6_TARGET=dns.google
CPE_IPV4_TARGET=8.8.8.8
CPE_MAX_HOPS=5

# Flask Configuration
SECRET_KEY=
