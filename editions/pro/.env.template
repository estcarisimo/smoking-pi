# Generate with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash(input('password: ')))"
#: secret
WEB_ADMIN_PASSWORD_HASH=
# Run web-admin background jobs (daily OCA refresh + cache cleanup)
