# Pro Edition Environment Variables

# Timezone configuration
TZ=UTC

# Database Type: influxdb or clickhouse
TSDB_TYPE=influxdb

# InfluxDB Configuration
DOCKER_INFLUXDB_INIT_PASSWORD=
INFLUX_TOKEN=
INFLUX_ORG=smokeping
INFLUX_BUCKET=smokeping

# ClickHouse Configuration (if TSDB_TYPE=clickhouse)
CLICKHOUSE_USER=smokeping
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=smokeping
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# PostgreSQL Database
POSTGRES_DB=smokeping_targets
POSTGRES_USER=smokeping
POSTGRES_PASSWORD=

# Web Admin Configuration
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=
# Preferred: pbkdf2 password hash (takes precedence over WEB_ADMIN_PASSWORD).
# Generate with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash(input('password: ')))"
WEB_ADMIN_PASSWORD_HASH=
# Run web-admin background jobs (daily OCA refresh + cache cleanup)
ENABLE_SCHEDULER=true

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GF_SECURITY_SECRET_KEY=

# SmokePing Configuration
RRD_DIR=/data
# Resolver the smokeping container uses for its own hostname lookups. Pinned
# rather than inherited, because Docker writes a container's /etc/resolv.conf
# ONCE at creation: inheriting freezes whatever the host happened to be using
# at that instant, and a VPN/split-DNS resolver that later goes away takes
# every hostname target down silently (raw-IP targets keep working, which is
# the tell). Override for a deployment whose targets are internal names.
# The DNS *probes* are unaffected — they run `dig` against an explicit server.
SMOKEPING_DNS=
SMOKEPING_DNS_FALLBACK=

# CPE Microcut Detection
CPE_DISCOVERY_INTERVAL=3600
CPE_PROBE_RATE=5
CPE_PROBE_WINDOW=10
# Idle seconds between CPE probe windows (default 20; 0 = probe continuously)
CPE_PROBE_IDLE=
CPE_IPV6_TARGET=dns.google
CPE_IPV4_TARGET=8.8.8.8
CPE_MAX_HOPS=5

# Flask Configuration
SECRET_KEY=

# Config Manager API auth (optional)
# When set, config-manager requires "Authorization: Bearer <token>" on all
# routes except /health; web-admin sends it automatically.
CONFIG_API_TOKEN=

# AI assistant & health reports (optional — features disabled when empty)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
REPORT_INTERVAL=86400
AI_REPORTS_PER_DAY=8

# Which optional services Compose manages. This must list EVERY profile you
# rely on, because it is what `docker compose up -d` and `down` read.
# Starting a service once with `COMPOSE_PROFILES=mcp docker compose up -d
# mcp-server` leaves it running but UNMANAGED: the next `docker compose down`
# removes it and the following `up -d` does not bring it back. Nothing warns
# you — the MCP server just stops answering and OpenClaw silently falls back
# to shell commands.
#   influxdb | clickhouse  (pick one, matching TSDB_TYPE)
#   alerts                 (alerting engine — docs/alerting.md)
#   mcp                    (MCP server — docs/mcp-server.md)
#   ai                     (AI health reports — docs/ai-insights.md)
COMPOSE_PROFILES=influxdb

# MCP server (opt-in: add `mcp` to COMPOSE_PROFILES — see docs/mcp-server.md).
# Bearer token required on the HTTP transport; empty = unauthenticated.
# Generate with: openssl rand -hex 32
MCP_API_TOKEN=

# Deep links in MCP tool responses (and the web-admin AI chat): the address a
# person reading the answer can actually open. Leave empty and the tools return
# numbers without links — which is deliberate, since this host answers on a LAN
# IP, a Tailscale name and possibly a tunnel hostname, and a link to the wrong
# one is worse than no link at all.
#
# Set the host and the standard ports are appended (:3000 Grafana, :8080
# web-admin):
#   PUBLIC_BASE_HOST=192.168.86.27
#   PUBLIC_BASE_HOST=smokingpi.tailnet-name.ts.net
# Or set the full URLs, for a reverse proxy or Cloudflare tunnel where the
# ports are not part of the address (these win over PUBLIC_BASE_HOST):
#   GRAFANA_PUBLIC_URL=https://grafana.example.com
#   WEB_ADMIN_PUBLIC_URL=https://admin.example.com
PUBLIC_BASE_HOST=
GRAFANA_PUBLIC_URL=
WEB_ADMIN_PUBLIC_URL=

# The same three again, for the address that works from OUTSIDE the home
# network — a Cloudflare tunnel, typically. Set both tiers and every link is
# offered twice: the LAN one (faster, and up even when the tunnel isn't) and
# the from-anywhere one, so an answer read on cellular still has a link that
# opens. Set only these and they become the only links.
#   ./shared/scripts/create-tunnel.sh create   # then show-tunnel-urls.sh
#
# Quick tunnels print a fresh *.trycloudflare.com hostname on every restart —
# fine to paste here for a while, but a named tunnel is what you want if the
# links are going into alerts.
# Include the scheme. A bare host gets http:// and the service port appended
# (:3000, :8080), which is right for a LAN address and wrong for every tunnel
# — they answer https on 443. `TUNNEL_BASE_HOST=smokingpi.example.com` becomes
# http://smokingpi.example.com:3000 and produces a dead link that looks fine.
#   TUNNEL_BASE_HOST=https://smokingpi.example.com
#   GRAFANA_TUNNEL_URL=https://grafana.example.com
#   WEB_ADMIN_TUNNEL_URL=https://admin.example.com
TUNNEL_BASE_HOST=
GRAFANA_TUNNEL_URL=
WEB_ADMIN_TUNNEL_URL=

# IPv6 gating (see docs/ipv6-gating.md). Empty = defaults below.
# IPV6_MODE: auto (probe the host) | force (always measure) | off (never)
IPV6_MODE=
# Comma-separated IPv6 addresses to ping when probing; default is
# 2001:4860:4860::8888,2606:4700:4700::1111
IPV6_PROBE_HOSTS=
# Seconds between background rechecks (default 900)
IPV6_RECHECK_INTERVAL=

# Alerting engine (opt-in: COMPOSE_PROFILES=alerts — see docs/alerting.md)
# All keys optional; empty = compose defaults apply (NOTIFY_MODE=off is
# log-only, so the service is safe to start unconfigured).
# NOTIFY_MODE: off | openclaw | webhook
NOTIFY_MODE=
# OpenClaw delivery (NOTIFY_MODE=openclaw). Alerts are sent by invoking
# OpenClaw's `message` tool over the Gateway's HTTP endpoint,
# POST {OPENCLAW_URL}/tools/invoke. See docs/openclaw-integration.md.
#
# The alerter runs with network_mode: host, so the loopback default reaches
# the gateway directly.
# OPENCLAW_URL=<http://127.0.0.1:18789>
OPENCLAW_URL=
# Endpoint path. Default /tools/invoke, which stock OpenClaw always serves.
# Override only to route through a proxy or bridge.
OPENCLAW_HOOK_PATH=
# Gateway token — copy gateway.auth.token from ~/.openclaw/openclaw.json.
# OPENCLAW_GATEWAY_TOKEN=<gateway.auth.token>
OPENCLAW_GATEWAY_TOKEN=
# Legacy alias for the above; OPENCLAW_GATEWAY_TOKEN wins if both are set.
OPENCLAW_HOOK_TOKEN=
# OPENCLAW_CHANNEL=<telegram>  (default: telegram)
OPENCLAW_CHANNEL=
# Recipient, in OpenClaw's addressing form. Find it with:
#   openclaw gateway call sessions-list  (or see deliveryContext.to)
# OPENCLAW_TO=<telegram:123456789>
OPENCLAW_TO=

# Daily digest — a wall-clock summary of the last window, so that silence on
# a good day means "nothing broke" instead of "the monitor stopped". Off by
# default; it needs NOTIFY_MODE set to actually deliver.
#
# DIGEST_AT is HH:MM in DIGEST_TZ (falling back to TZ, then UTC). A value
# that is not HH:MM disables the digest with a warning and leaves alerting
# untouched. DIGEST_MAX_LATENESS (seconds, default 4h) is how late a missed
# slot may still be delivered — past it the slot is retired silently, so a Pi
# that was powered off for two days does not deliver yesterday's news, or two
# of them, on boot.
DIGEST_ENABLED=false
DIGEST_AT=08:30
DIGEST_TZ=
DIGEST_WINDOW_HOURS=24
DIGEST_MAX_LATENESS=14400
# A daily summary is something you read, not something that should buzz.
DIGEST_SILENT=true
DIGEST_HISTORY_MAX=200

# Generic webhook delivery (NOTIFY_MODE=webhook)
# ALERT_WEBHOOK_URL=<https://your-endpoint.example/hook>
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TOKEN=<optional-bearer-token>
ALERT_WEBHOOK_TOKEN=
# Cadence (seconds): evaluation interval, re-notify cooldown, report delivery
ALERT_INTERVAL=
ALERT_COOLDOWN=
# Seconds an incident must be absent before a recovery notice fires. Guards
# against a flapping rule alternating alert/recovery forever. Default 900.
ALERT_RESOLVE_AFTER=
# Hard cap on notifications per incident per rolling hour. Default 6.
ALERT_MAX_PER_HOUR=
REPORT_DELIVERY_INTERVAL=
# Rule windows (seconds). Both default to 1200 = four points at the 300 s
# probe step, so ordinary window jitter still leaves the three points the
# rules require. Do not lower to 900: that yields exactly three points, and
# losing one to jitter makes an incident look resolved and flap.
DOWN_WINDOW=
STALE_WINDOW=
# Alert message rendering: html (default, Telegram's parse mode) | plain
ALERT_MARKUP=
# Charts attached to alerts (true/false), the window each covers, the theme a
# static image commits to (it cannot follow the reader's), the byte cap before
# a chart is dropped rather than shrunk further, whether images are sent as
# documents (Telegram re-encodes photos as JPEG, which wrecks thin lines), and
# whether delivery is silent (no notification buzz).
ALERT_CHARTS=
CHART_HOURS=
CHART_THEME=
CHART_MAX_BYTES=
ALERT_IMAGE_AS_DOCUMENT=
ALERT_SILENT=
# "Is it me or the internet?" verdict thresholds. Share of measurable targets
# that must be impaired to call a problem broad; the minimum number of targets
# for breadth to mean anything; the mean-loss percent at which a target counts
# as impaired; and how long a target must sit at 100% before it is treated as
# a host that never answered ICMP rather than one that broke.
VERDICT_BROAD_PCT=
VERDICT_MIN_TARGETS=
VERDICT_IMPAIRED_LOSS_PCT=
VERDICT_STALE_DOWN_HOURS=
