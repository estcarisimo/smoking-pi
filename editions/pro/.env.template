## Alerts: delivery
# Alerting engine (opt-in: `smoking-pi alerts …`, or `smoking-pi enable alerts` — see docs/alerting.md)
# All keys optional; empty = compose defaults apply (NOTIFY_MODE=off is
# log-only, so the service is safe to start unconfigured).
# NOTIFY_MODE: off | telegram | openclaw | webhook
#: enum:off|telegram|openclaw|webhook
NOTIFY_MODE=
# Telegram delivery (NOTIFY_MODE=telegram): straight to a bot of your own,
# no OpenClaw needed. `sudo smoking-pi alerts --telegram` asks for the token
# (from @BotFather) and finds the chat id from a message you send the bot.
#: secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# OpenClaw delivery (NOTIFY_MODE=openclaw). Alerts are sent by invoking
# OpenClaw's `message` tool over the Gateway's HTTP endpoint,
# POST {OPENCLAW_URL}/tools/invoke. See docs/openclaw-integration.md.
#
# The alerter runs with network_mode: host, so the loopback default reaches
# the gateway directly.
# OPENCLAW_URL=<http://127.0.0.1:18789>
#: url
OPENCLAW_URL=
# The MCP server's `get_chart(deliver=true)` posts through the same endpoint
# with the same token and recipient (it runs on the host network too).
# Endpoint path. Default /tools/invoke, which stock OpenClaw always serves.
# Override only to route through a proxy or bridge.
OPENCLAW_HOOK_PATH=
# Gateway token — copy gateway.auth.token from ~/.openclaw/openclaw.json.
# OPENCLAW_GATEWAY_TOKEN=<gateway.auth.token>
#: secret
OPENCLAW_GATEWAY_TOKEN=
# Legacy alias for the above; OPENCLAW_GATEWAY_TOKEN wins if both are set.
#: secret
OPENCLAW_HOOK_TOKEN=
# OPENCLAW_CHANNEL=<telegram>  (default: telegram)
OPENCLAW_CHANNEL=
# Recipient, in OpenClaw's addressing form. Find it with:
#   openclaw gateway call sessions-list  (or see deliveryContext.to)
# OPENCLAW_TO=<telegram:123456789>
OPENCLAW_TO=

## Alerts: daily digest
# Daily digest — a wall-clock summary of the last window, so that silence on
# a good day means "nothing broke" instead of "the monitor stopped". Off by
# default; it needs NOTIFY_MODE set to actually deliver.
#
# DIGEST_AT is HH:MM in DIGEST_TZ (falling back to TZ, then UTC). A value
# that is not HH:MM disables the digest with a warning and leaves alerting
# untouched. DIGEST_MAX_LATENESS (seconds, default 4h) is how late a missed
# slot may still be delivered — past it the slot is retired silently, so a Pi
# that was powered off for two days does not deliver yesterday's news, or two
# of them, on boot.
#: bool
DIGEST_ENABLED=false
#: time
DIGEST_AT=08:30
#: tz
DIGEST_TZ=
#: int min=1
DIGEST_WINDOW_HOURS=24
#: int min=1
DIGEST_MAX_LATENESS=14400
# A daily summary is something you read, not something that should buzz.
#: bool
DIGEST_SILENT=true
#: int min=1
DIGEST_HISTORY_MAX=200

## Alerts: mutes and diagnosis
# Alert mutes ("mute amazon for 2h"), set through the MCP tools rather than
# by editing this file. The mcp-server is the only writer; the alerter mounts
# it read-only, which is what makes the two containers safe without a lock.
# Leave unset unless you are relocating the volume. A mutes file that cannot
# be read means everything alerts — never the reverse.
ALERT_MUTES_FILE=

# When a loss alert fires, the last ALERT_DIAGNOSIS_HOURS (default 3) are
# diagnosed as diagnose_loss does, and the alert says what the episode was
# (this host's Wi-Fi, your line, upstream, one destination) and how sure.
# 0 turns it off.
#: int min=0 max=168
ALERT_DIAGNOSIS_HOURS=

## Alerts: webhook
# Generic webhook delivery (NOTIFY_MODE=webhook)
# ALERT_WEBHOOK_URL=<https://your-endpoint.example/hook>
#: secret url
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TOKEN=<optional-bearer-token>
#: secret
ALERT_WEBHOOK_TOKEN=
## Alerts: rules and messages
# Cadence (seconds): evaluation interval, re-notify cooldown, report delivery
#: int min=1
ALERT_INTERVAL=
#: int min=0
ALERT_COOLDOWN=
# Seconds an incident must be absent before a recovery notice fires. Guards
# against a flapping rule alternating alert/recovery forever. Default 900.
#: int min=0
ALERT_RESOLVE_AFTER=
# Hard cap on notifications per incident per rolling hour. Default 6.
#: int
ALERT_MAX_PER_HOUR=
#: int min=0
REPORT_DELIVERY_INTERVAL=
# Rule windows (seconds). Both default to 1200 = four points at the 300 s
# probe step, so ordinary window jitter still leaves the three points the
# rules require. Do not lower to 900: that yields exactly three points, and
# losing one to jitter makes an incident look resolved and flap. A probe on
# a slower step raises both to four of its steps on its own.
#: int min=1
DOWN_WINDOW=
#: int min=1
STALE_WINDOW=
# high_loss needs the loss to persist: this many probe cycles that lost two
# or more pings (15% of ten) in the window, default 2. One bad cycle
# averaged over the threshold is a blink, and a blink is reported once for
# everyone as an `outage`, not once per target as high loss.
#: int min=1
HIGH_LOSS_MIN_POINTS=
# Widespread loss: when this share of the reporting targets (default 80) loses
# at least WIDESPREAD_LOSS_PCT (default 30) in the same probe cycle, that is
# ONE incident -- `outage` for a cut that ended, `uplink_down` while every
# target sits at 100% -- and the per-target ones are not sent.
#: float min=0 max=100
WIDESPREAD_PCT=
#: float min=0 max=100
WIDESPREAD_LOSS_PCT=
# Alert message rendering: html (default, Telegram's parse mode) | plain
#: enum:html|plain
ALERT_MARKUP=
# Charts attached to alerts (true/false), the window each covers, the theme a
# static image commits to (light, or dark; it cannot follow the reader's), the
# byte cap before a chart is dropped rather than shrunk further, whether images
# are sent as documents instead of inline photos (default false: the charts are
# drawn large enough to survive Telegram's JPEG re-encoding), and whether
# delivery is silent (no notification buzz).
#: bool
ALERT_CHARTS=
#: int min=1
CHART_HOURS=
#: enum:light|dark
CHART_THEME=
#: int min=1
CHART_MAX_BYTES=
#: bool
ALERT_IMAGE_AS_DOCUMENT=
#: bool
ALERT_SILENT=
# "Is it me or the internet?" verdict thresholds. Share of measurable targets
# that must be impaired to call a problem broad; the minimum number of targets
# for breadth to mean anything; the mean-loss percent at which a target counts
# as impaired; and how long a target must sit at 100% before it is treated as
# a host that never answered ICMP rather than one that broke.
#: float min=0 max=100
VERDICT_BROAD_PCT=
#: int min=1
VERDICT_MIN_TARGETS=
#: float min=0 max=100
VERDICT_IMPAIRED_LOSS_PCT=
#: float min=0
VERDICT_STALE_DOWN_HOURS=
# The Wi-Fi uplink in the verdict (docs/wifi.md): signal in dBm below which it
# is weak (default -75), and how many samples in the hour must be below it
# before a cutting first hop is called "your Wi-Fi" (default 6 = one minute at
# WIFI_SAMPLE_INTERVAL=10; rescale them together). WIFI_WEAK_DBM is also what
# the MCP tool get_wifi_stats reports against.
#: float max=0
WIFI_WEAK_DBM=
#: int min=1
WIFI_WEAK_SAMPLES=

