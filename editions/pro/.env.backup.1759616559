# SmokePing Pro Edition Environment Configuration
# Copy to .env and customize for your deployment

# Time-Series Database Selection
# Choose between 'influxdb' or 'clickhouse'
TSDB_TYPE=clickhouse

# InfluxDB Configuration (when TSDB_TYPE=influxdb)
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=smokeping
INFLUX_BUCKET=smokeping
DOCKER_INFLUXDB_INIT_PASSWORD=your-influxdb-admin-password

# ClickHouse Configuration (when TSDB_TYPE=clickhouse)
CLICKHOUSE_USER=smokeping
CLICKHOUSE_PASSWORD=X8Zwak04xkp2I0Nl6E02xP40ZhGsaTco
CLICKHOUSE_DB=smokeping

