# Cloudflare Tunnel Configuration Template
# Copy to .env and customize for your deployment

# REQUIRED: Your Cloudflare Tunnel Token
# Get this from: https://one.dash.cloudflare.com/
# Navigate to: Zero Trust > Networks > Tunnels > Create/Edit Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# OPTIONAL: Custom tunnel name (defaults to 'smokeping-tunnel')
# TUNNEL_NAME=my-custom-smokeping

# OPTIONAL: Tunnel configuration override
# Leave blank to use automatic configuration based on edition
# TUNNEL_CONFIG_PATH=/path/to/custom/config.yml