          { "matcher": { "id": "byName", "options": "min" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.protocol == \"ipv4\" and r._field == \"median\") |> yield(name:\"median\")"
        },
        {
          "refId": "B",
