{
  "uid": "cpe-microcut-v1",
  "id": null,
  "title": "CPE Microcut Detection",
  "schemaVersion": 37,
  "version": 1,
  "tags": ["smokeping", "cpe", "microcuts"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",

  "templating": { "list": [] },

  "panels": [
    {
      "type": "row",
      "title": "CPE Latency (5 pps high-frequency probing)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPE IPv6 – Latency (ms)",
      "datasource": { "uid": "influxdb" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "pointSize": 3,
            "showPoints": "auto"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "min" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.protocol == \"ipv6\" and r._field == \"median\") |> yield(name:\"median\")"
        },
        {
          "refId": "B",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.protocol == \"ipv6\" and r._field == \"max\") |> yield(name:\"max\")"
        },
        {
          "refId": "C",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.protocol == \"ipv6\" and r._field == \"min\") |> yield(name:\"min\")"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPE IPv4 – Latency (ms)",
      "datasource": { "uid": "influxdb" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
