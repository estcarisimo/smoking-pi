{
  "uid": "wifi-link-v1",
  "id": null,
  "title": "Wi-Fi Link",
  "description": "The wireless uplink of the machine running Smoking Pi, from wifi_link.py: signal, negotiated bitrate, throughput, failures, roams. Empty on a wired host. Some panels are empty on drivers that do not report a survey or modulation details (brcmfmac on a Raspberry Pi) — each says so.",
  "schemaVersion": 37,
  "version": 1,
  "tags": [
    "smokeping",
    "wifi"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "SmokePing dashboards",
      "type": "dashboards",
      "tags": [
        "smokeping"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "interface",
        "label": "Interface",
        "datasource": {
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/v1\"\n  v1.tagValues(bucket: \"smokeping\", predicate: (r) => r._measurement == \"wifi_link\", tag: \"interface\")",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
