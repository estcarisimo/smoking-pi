    {
      "type": "timeseries",
      "title": "CPE Packet Loss (%) – IPv6",
      "description": "Loss per probe burst for $cpe, in percent (0-100) as written by microcut_detector.py. Thresholds match the stat tiles: yellow >= 1%, red >= 5%.",
      "datasource": { "uid": "influxdb" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "maxDataPoints": 720,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "pointSize": 5,
            "spanNulls": false,
            "thresholdsStyle": { "mode": "dashed" }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.target == \"${cpe}\" and r.protocol == \"ipv6\" and r._field == \"loss\") |> yield(name:\"loss\")"
