{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Uplink changed",
        "target": {
          "refId": "Anno",
          "queryType": "flux",
          "query": "from(bucket: \"smokeping\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"host_uplink\" and (r._field == \"previous\" or r._field == \"interface\" or r._field == \"kind\")) |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> filter(fn: (r) => exists r.previous) |> map(fn: (r) => ({_time: r._time, text: \"Uplink \" + r.previous + \" → \" + (if r.interface == \"\" then \"none\" else r.interface + \" (\" + r.kind + \")\"), tags: \"uplink\"}))"
        }
      }
    ]
  },
  "uid": "cpe-microcut-v1",
  "id": null,
  "title": "CPE Microcut Detection",
  "description": "High-frequency (5 pps) probing of the CPE/first hop. Loss here is written by microcut_detector.py as PERCENT (0-100), unlike the SmokePing exporter which writes a 0-1 ratio.",
  "schemaVersion": 37,
  "version": 3,
  "tags": ["smokeping", "cpe", "microcuts"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",

  "links": [
    {
      "title": "SmokePing dashboards",
      "type": "dashboards",
      "tags": ["smokeping"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],

  "templating": {
    "list": [
      {
        "type": "query",
        "name": "cpe",
        "label": "CPE",
        "datasource": { "uid": "influxdb" },
        "query": "import \"influxdata/influxdb/v1\"\n  v1.tagValues(bucket: \"smokeping\", predicate: (r) => r._measurement == \"cpe_latency\", tag: \"target\")",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },

  "panels": [
    {
      "type": "row",
      "title": "CPE Latency (5 pps high-frequency probing)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPE IPv6 – Latency (ms)",
      "description": "Median/min/max latency to $cpe over IPv6.",
      "datasource": { "uid": "influxdb" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 1 },
      "maxDataPoints": 720,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 3,
            "showPoints": "auto"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "min" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.target == \"${cpe}\" and r.protocol == \"ipv6\" and r._field == \"median\") |> yield(name:\"median\")"
        },
        {
          "refId": "B",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.target == \"${cpe}\" and r.protocol == \"ipv6\" and r._field == \"max\") |> yield(name:\"max\")"
        },
        {
          "refId": "C",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"cpe_latency\" and r.target == \"${cpe}\" and r.protocol == \"ipv6\" and r._field == \"min\") |> yield(name:\"min\")"
        }
      ]
    },
