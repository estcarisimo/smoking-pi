    {
      "type": "timeseries",
      "title": "Wi-Fi uplink – signal (dBm) and TX failures/s",
      "description": "The Pi's own wireless link, on the same time axis as the microcuts above. A cut that lines up with a signal dip or a failure burst is the router or the air, not the ISP. Empty when the Pi is wired; every wireless interface is drawn (this dashboard has no interface variable). Dashed lines: −67 dBm (comfortable above) and −75 dBm (weak below). Full detail: the Wi-Fi Link dashboard.",
      "datasource": { "uid": "influxdb" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 11 },
      "maxDataPoints": 720,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": -75 },
              { "color": "green", "value": -67 }
            ]
          },
          "custom": {
            "lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "pointSize": 3, "showPoints": "auto",
            "thresholdsStyle": { "mode": "dashed" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "tx failed/s" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.drawStyle", "value": "bars" },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"wifi_link\" and r._field == \"signal_dbm\") |> yield(name:\"signal\")"
        },
        {
          "refId": "B",
          "datasource": { "uid": "influxdb" },
          "query": "from(bucket:\"smokeping\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop) |> filter(fn:(r) => r._measurement == \"wifi_link\" and r._field == \"tx_failed\") |> derivative(unit: 1s, nonNegative: true) |> yield(name:\"tx failed/s\")"
        }
      ]
    },
