{
  "uid": "smokeping-lat-pct-clickhouse-v1",
  "id": null,
  "title": "SmokePing Latency & Loss \u2013 Percentiles / Mean",
  "schemaVersion": 37,
  "version": 1,
  "tags": [
    "smokeping"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "target",
        "label": "Target",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT DISTINCT target FROM smokeping.latency WHERE target NOT IN ('Cloudflare', 'Quad9') AND measurement_type <> 'dns_latency' ORDER BY target",
        "hide": 0,
        "multi": false,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          }
        ],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Latency \u2013 [[target]] (ms)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "repeat": "target",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "average"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.zindex",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mean"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 1.5
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.zindex",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p10"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.zindex",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p20"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.zindex",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p80"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 40
              },
              {
                "id": "custom.fillBelowTo",
                "value": "p20"
              },
              {
                "id": "custom.zindex",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 25
              },
              {
                "id": "custom.fillBelowTo",
                "value": "p10"
              },
              {
                "id": "custom.zindex",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(avg_latency) as average FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' AND avg_latency > 0 GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "B",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(avg_latency) as mean FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' AND avg_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "C",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p10_latency) as p10 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' AND p10_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "D",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p20_latency) as p20 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' AND p20_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "E",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p80_latency) as p80 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' AND p80_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "F",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p90_latency) as p90 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' AND p90_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Loss \u2013 [[target]] (%)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "repeat": "target",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "refId": "loss",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(packet_loss) as loss FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND measurement_type <> 'dns_latency' GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        }
      ]
    }
  ]
}
