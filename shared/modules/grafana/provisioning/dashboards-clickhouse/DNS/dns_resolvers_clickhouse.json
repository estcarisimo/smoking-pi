      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2
          },
          "displayName": "Loss"
        }
      },
      "targets": [
        {
          "refId": "loss",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(packet_loss) as loss FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        }
      ]
    }
  ],
  "description": "One row per resolver: its resolution time on the left (median, mean, percentile bands, min/max envelope of the five queries, with the 15-minute windows in which nothing answered or 1.5 queries or more were lost as bars) and the share of queries lost on the right. Pick resolvers above."
}
