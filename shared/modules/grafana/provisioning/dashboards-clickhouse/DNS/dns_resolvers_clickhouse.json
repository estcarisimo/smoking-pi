      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(median_latency) as median FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND median_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "B",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(avg_latency) as mean FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND avg_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "C",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p10_latency) as p10 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND p10_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "D",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p20_latency) as p20 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND p20_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "E",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p80_latency) as p80 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND p80_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "F",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, avg(p90_latency) as p90 FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND p90_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "G",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, min(min_latency) as min FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND min_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "H",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(timestamp)*1000 as time, max(max_latency) as max FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' AND max_latency IS NOT NULL GROUP BY timestamp ORDER BY timestamp",
          "format": 1
        },
        {
          "refId": "I",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(w + INTERVAL 15 MINUTE)*1000 as time, unreachable FROM (SELECT toStartOfInterval(timestamp, INTERVAL 15 MINUTE) as w, if(min(least(packet_loss, 100.0)) >= 100.0, 1.0, 0.0) as unreachable FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' GROUP BY w) ORDER BY time",
          "format": 1
        },
        {
          "refId": "J",
          "queryType": "sql",
          "rawSql": "SELECT toUnixTimestamp(w + INTERVAL 15 MINUTE)*1000 as time, lossy FROM (SELECT toStartOfInterval(timestamp, INTERVAL 15 MINUTE) as w, if(sum(least(packet_loss, 100.0) / 100.0 * coalesce(packets_sent, if(measurement_type = 'latency', 10, 5))) >= 1.5, 1.0, 0.0) as lossy FROM smokeping.latency WHERE timestamp >= toDateTime64($__from/1000, 3) AND timestamp <= toDateTime64($__to/1000, 3) AND target IN (${target:sqlstring}) AND category = 'dns' AND measurement_type = 'dns_latency' GROUP BY w) ORDER BY time",
          "format": 1
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DNS Packet Loss \u2013 [[target]] (%)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
