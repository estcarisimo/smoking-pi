# Starts the Smoking Pi stack at boot and stops it cleanly at shutdown.
# Docker's own restart policy already restarts containers; this unit exists
# so that `systemctl status smoking-pi` means something, so the stack starts
# after the Docker daemon (and the network) rather than racing it, and so an
# uninstall has one thing to disable.
[Unit]
Description=Smoking Pi network monitoring stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=SMOKING_PI_HOME=/opt/smoking-pi
Environment=SMOKING_PI_EDITION=pro
EnvironmentFile=-/etc/default/smoking-pi
ExecStart=/usr/bin/smoking-pi up
ExecStop=/usr/bin/smoking-pi down
# The first `up` on a fresh host builds nine images (until they are pulled
# from a registry -- docs/packaging.md backlog #3), which can take longer
# than any sensible timeout; systemd killing a build half-way is worse than
# waiting. Run `smoking-pi install` interactively first; this unit is for
# every boot after that.
TimeoutStartSec=infinity
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
