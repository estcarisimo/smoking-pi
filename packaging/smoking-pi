#!/usr/bin/env bash
# The smoking-pi command moved to cli/smoking-pi (v2.28.0). This forwards
# for what still names the old path: a clone's /usr/local/bin link made
# before the move (`smoking-pi upgrade` and `link` repoint it) and the
# Homebrew formula of a release older than the move.
exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../cli/smoking-pi" "$@"
