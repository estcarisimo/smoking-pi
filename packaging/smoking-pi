#!/usr/bin/env bash
# smoking-pi — one command in front of the Compose stack.
#
# Prototype from the packaging evaluation (docs/packaging.md). Works from a
# clone today (SMOKING_PI_HOME defaults to the checkout this file sits in)
# and from /opt/smoking-pi when installed by the .deb. Everything it does is
# what the README tells a person to type by hand; it adds no behavior, it
# removes the need to know which directory to be in.
#
# Needs bash >= 4.4 and GNU readlink (Debian, Ubuntu, Raspberry Pi OS). On
# macOS that means Homebrew's bash and coreutils -- see docs/packaging.md.
set -euo pipefail

# The package's settings (/etc/default/smoking-pi: edition, the packaged
# state layout). Debian's convention is that every consumer sources it; the
# unit does via EnvironmentFile, and so must a manual `sudo smoking-pi
# install`, or it would write into /opt. The environment still wins.
if [ -f /etc/default/smoking-pi ]; then
    _env_before="$(export -p)"
    # shellcheck disable=SC1091
    set -a; . /etc/default/smoking-pi; set +a
    # Re-apply what the caller had exported, so it overrides the file.
    eval "$_env_before"; unset _env_before
fi
SMOKING_PI_HOME="${SMOKING_PI_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
SMOKING_PI_EDITION="${SMOKING_PI_EDITION:-pro}"
EDITION_DIR="$SMOKING_PI_HOME/editions/$SMOKING_PI_EDITION"
VERSION_FILE="$SMOKING_PI_HOME/CITATION.cff"
# Where the state the stack rewrites lives (docs/packaging.md, "Relocatable
# state"). From a clone the defaults are beside the compose file, untracked;
# the .deb sets the packaged layout in /etc/default/smoking-pi. The env file
# is passed to every compose call; the two directories are read by the
# compose file itself, so they only need exporting.
SMOKING_PI_ENV_FILE_SET="${SMOKING_PI_ENV_FILE:+1}"
ENV_FILE="${SMOKING_PI_ENV_FILE:-$EDITION_DIR/.env}"
export SMOKING_PI_ENV_FILE="$ENV_FILE"
export SMOKING_PI_CONFIG_DIR="${SMOKING_PI_CONFIG_DIR:-}"
export SMOKING_PI_OUTPUT_DIR="${SMOKING_PI_OUTPUT_DIR:-}"

usage() {
    cat <<USAGE
smoking-pi — SmokePing on a Raspberry Pi, with the trimmings

Usage: smoking-pi <command> [args]

  install [--edition basic|standard|pro] [--database influxdb|clickhouse] [--yes]
                     First install only: generate secrets, choose profiles,
                     start the stack, print what to open. Interactive unless
                     --yes. Refuses to run over an existing env file (it
                     would rotate the secrets the data volumes already hold).
  up | down | restart | status | logs [service]
                     The Compose stack, with the profiles recorded in the env file.
  passwords          Show credentials and URLs (show-passwords.sh).
  doctor [--live]    Instrumentation doctor (needs the doctor package).
  paths              Where things are (home, edition, env file, config, output, data).
  version            Installed version.

Environment: SMOKING_PI_HOME (default: this checkout or /opt/smoking-pi),
             SMOKING_PI_EDITION (default: pro),
             SMOKING_PI_PACKAGED=1 adds docker-compose.packaged.yml (no source
             bind-mounts; the package sets it),
             SMOKING_PI_ENV_FILE, SMOKING_PI_CONFIG_DIR, SMOKING_PI_OUTPUT_DIR
             (default: beside the edition's compose file; the package sets
             /etc/smoking-pi/env, /etc/smoking-pi/config, /var/lib/smoking-pi/output).
USAGE
}

need_edition() {
    [ -d "$EDITION_DIR" ] || { echo "no edition at $EDITION_DIR" >&2; exit 1; }
}

profiles() {
    # COMPOSE_PROFILES is written into the env file by setup.sh; honor it.
    [ -f "$ENV_FILE" ] && sed -n 's/^COMPOSE_PROFILES=//p' "$ENV_FILE" | tail -1 || true
}

compose() {
    need_edition
    local p; p="$(profiles)"
    local extra=(--env-file "$ENV_FILE" -f docker-compose.yml)
    if [ "$SMOKING_PI_EDITION" = pro ] && [[ "$p" == *clickhouse* ]]; then
        extra+=(-f docker-compose.clickhouse.yml)
    fi
    # Packaged mode: no source bind-mounts (docs/packaging.md, "Packaged
    # mode"). Last, so its !override wins over the ClickHouse overlay.
    if [ "${SMOKING_PI_PACKAGED:-0}" = 1 ] && [ -f "$EDITION_DIR/docker-compose.packaged.yml" ]; then
        extra+=(-f docker-compose.packaged.yml)
    fi
    ( cd "$EDITION_DIR" && COMPOSE_PROFILES="$p" docker compose "${extra[@]}" "$@" )
}

cmd_install() {
    local edition="$SMOKING_PI_EDITION" database=influxdb yes=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --edition) edition="$2"; shift 2 ;;
            --database) database="$2"; shift 2 ;;
            --yes|-y) yes=1; shift ;;
            *) echo "unknown option $1" >&2; exit 2 ;;
        esac
    done
    if [ "$yes" = 0 ] && command -v whiptail >/dev/null; then
        edition=$(whiptail --title "Smoking Pi" --menu "Which edition?" 15 60 3 \
            basic "SmokePing only" standard "+ web admin and PostgreSQL" \
            pro "+ Grafana, InfluxDB, alerts, MCP" 3>&1 1>&2 2>&3) || exit 1
        if [ "$edition" = pro ]; then
            database=$(whiptail --title "Smoking Pi" --menu "Time-series backend?" 12 60 2 \
                influxdb "InfluxDB 2 (recommended)" clickhouse "ClickHouse (experimental)" 3>&1 1>&2 2>&3) || exit 1
        fi
    fi
    SMOKING_PI_EDITION="$edition"; EDITION_DIR="$SMOKING_PI_HOME/editions/$edition"
    # An explicit SMOKING_PI_ENV_FILE wins; otherwise the env file follows
    # the edition chosen here, not the default edition computed at the top.
    [ -n "${SMOKING_PI_ENV_FILE_SET:-}" ] || ENV_FILE="$EDITION_DIR/.env"
    export SMOKING_PI_ENV_FILE="$ENV_FILE"
    need_edition
    if [ -f "$ENV_FILE" ]; then
        # setup.sh regenerates every secret. Against volumes that already
        # hold the old PostgreSQL/InfluxDB credentials that is a broken
        # stack, not a reinstall -- so an existing install is never re-run
        # by accident. (Backlog #4 in docs/packaging.md gives upgrade its
        # own command.)
        echo "$ENV_FILE exists: this edition is already installed." >&2
        echo "Use 'smoking-pi up' to start it. To start over, stop the stack, remove its" >&2
        echo "volumes (docker volume ls | grep ${edition}_), delete the env file, then run install again." >&2
        exit 1
    fi
    echo "Installing the $edition edition from $SMOKING_PI_HOME (env file: $ENV_FILE)"
    if [ "$edition" = pro ]; then
        ( cd "$EDITION_DIR" && ./setup.sh --database "$database" --env-file "$ENV_FILE" )
    else
        ( cd "$EDITION_DIR" && ./setup.sh )
    fi
    if [ "$edition" = pro ] && [ "$yes" = 0 ] && command -v whiptail >/dev/null; then
        if whiptail --title "Smoking Pi" --yesno \
            "Connect a chat assistant?\n\nOpenClaw can answer 'how is my internet?' from this Pi's history (docs/openclaw-integration.md). Show the steps now?" 12 70; then
            echo; echo "Next: enable the mcp profile and register the server —"
            echo "  see $SMOKING_PI_HOME/docs/openclaw-integration.md"
        fi
    fi
    echo; ( cd "$EDITION_DIR" && ./show-passwords.sh 2>/dev/null || true )
}

case "${1:-}" in
    install) shift; cmd_install "$@" ;;
    up) shift; compose up -d "$@" ;;
    down) shift; compose down "$@" ;;
    restart) shift; compose restart "$@" ;;
    status) shift; compose ps "$@" ;;
    logs) shift; compose logs --tail=200 -f "$@" ;;
    passwords) need_edition; ( cd "$EDITION_DIR" && ./show-passwords.sh ) ;;
    doctor) shift; ( cd "$SMOKING_PI_HOME" && PYTHONPATH="$SMOKING_PI_HOME/shared/modules/doctor${PYTHONPATH:+:$PYTHONPATH}" python3 -m doctor --repo-root . "$@" ) ;;
    paths)
        echo "home:     $SMOKING_PI_HOME"; echo "edition:  $SMOKING_PI_EDITION ($EDITION_DIR)"
        echo "env:      $ENV_FILE"; echo "profiles: $(profiles)"
        echo "config:   ${SMOKING_PI_CONFIG_DIR:-$EDITION_DIR/config-manager/config}"
        echo "output:   ${SMOKING_PI_OUTPUT_DIR:-$EDITION_DIR/config-manager/output}"
        echo "mode:     $([ "${SMOKING_PI_PACKAGED:-0}" = 1 ] && echo packaged '(no source mounts)' || echo development '(source mounts from home)')"
        echo "data:     docker volumes ${SMOKING_PI_EDITION}_* (docker volume ls)" ;;
    version) sed -n 's/^version: *//p' "$VERSION_FILE" 2>/dev/null || echo unknown ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
